{
  "manifest_version": 3,
  "name": "Red Agentic Teams — Auth Flow Telemetry",
  "version": "1.0.0",
  "description": "Records metadata-only OTP and CAPTCHA challenge state for an authorized local assessment run.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
