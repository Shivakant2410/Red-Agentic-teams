# Secrets — never commit
.secrets/
*.key
secrets.env
.env

# Run outputs (findings, audit logs, reports, graphs)
runs/
runs_*.log

# Proven-proof templates can embed literal auth headers/credentials — keep local.
memory/skills.json
memory/skills_nuclei.json
# Cross-engagement learned state (lessons, bandit win-rates) — local to this machine's
# run history, not something to ship in the repo.
memory/experience.json
memory/bandit.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
# Downloaded/cloned corpora live here (nuclei templates etc.) and stay untracked —
# EXCEPT the first-party technique playbooks, which ship in-repo by design
# (offline research layer, see docs/tool-integration-plan.md §5).
data/*
!data/playbooks/

# Runtime state (catalog, usage sqlite) — local to this machine
.state/
.tools/
